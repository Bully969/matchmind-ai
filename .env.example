# App
APP_NAME=MatchMind AI
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data provider: openfootball_remote | demo | openfootball | football_data_org | api_football
# openfootball_remote uses public-domain fixtures/results; no odds, live events, xG, lineups or injury feeds.
# Choose demo only for isolated UI development with synthetic matches.
DATA_PROVIDER=openfootball_remote
# Synthetic DemoProvider runs only with explicit opt-in (development/testing only).
ALLOW_SYNTHETIC_DEMO=false
OPENFOOTBALL_DATA_DIR=./data/openfootball

# Optional official API sources (keep keys only in backend environment variables)
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_KEY=

# AI provider: template | ollama | openai_compatible
# For local Windows run use http://127.0.0.1:11434; in Docker Compose use host.docker.internal.
AI_PROVIDER=template
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Local SQLite by default. In hosted setup use a PostgreSQL URL from your database provider.
DATABASE_URL=sqlite:///./data/tipster.db

# Cache seconds
FIXTURES_CACHE_TTL=1800
COMPETITIONS_CACHE_TTL=21600
